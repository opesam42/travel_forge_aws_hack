# TravelForge Backend Environment

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local Docker or hosted provider)
DATABASE_URL=postgresql://user:password@localhost:5432/travelforge
AUTH_SESSION_TTL_HOURS=168
# Set CORS_ORIGIN to comma-separated exact frontend origins in production.
CHAT_HISTORY_LIMIT=12
CHAT_MESSAGE_MAX_LENGTH=10000

# AI provider credentials (Gemma 4 via Google AI & Groq)
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider selection: google_genai or groq.
# LLM_PROVIDER overrides PRIMARY_LLM_PROVIDER.
PRIMARY_LLM_PROVIDER=google_genai
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
GEMMA_MODEL=gemma-4-26b-a4b-it
GROQ_MODEL=gemma-4-26b-a4b-it
GEMINI_MODEL=gemma-4-26b-a4b-it

# Qdrant credentials are needed only for the one-time migration into pgvector.
QDRANT_CLUSTER_ENDPOINT_KEY=https://your-qdrant-cluster-url
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=business_knowledge
# Cached MiniLM model files; vector data itself is stored in PostgreSQL.
RAG_EMBEDDING_CACHE_DIR=~/.cache/travelforge/all-MiniLM-L6-v2
# On Vercel, use a writable temporary path, e.g. /tmp/travelforge/all-MiniLM-L6-v2.

# Provider defaults (LLM_MODEL overrides provider-specific model defaults).
CHAT_MODEL=gemma-4-26b-a4b-it
AUDIT_MODEL=gemma-4-26b-a4b-it
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.55
